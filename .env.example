[TEMPLATE]
# Copy to .env.local and fill in. This file is safe to commit (values are blank).

# Public Mapbox access token (used in the browser for the search/map views).
# Create one at https://account.mapbox.com/access-tokens and restrict it to
# your site's domains so nobody else can use your quota.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Supabase — used server-side only (route handlers / API). Never import these
# into client components. Create a project at https://supabase.com, then copy
# from Project Settings > API: the Project URL and the "secret key"
# (sb_secret_...) in the new-style API keys screen.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Passcode for the private moderation page at /admin (reviews + reports queues).
# Set the same value on Vercel. Pick something long and random.
MODERATION_PASS=
